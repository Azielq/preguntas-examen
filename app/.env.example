# Análisis con IA (PLAN-IA 2.3). Copiá este archivo a .env.local y completá los valores.
# Todas son variables SOLO DEL SERVIDOR: no usar el prefijo VITE_ (llegaría al navegador).
# .env.local está en .gitignore y .vercelignore: nunca subas claves al repositorio.

# Clave de la API de Anthropic (consola de Anthropic → API keys). Usá una clave dedicada a esta app.
ANTHROPIC_API_KEY=

# Secreto compartido que cada usuario carga en Ajustes → Análisis con IA. Mínimo 24 caracteres.
# Generalo, por ejemplo, con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AI_ACCESS_TOKEN=

# Opcionales (valores por defecto entre paréntesis)
# AI_MODEL=claude-sonnet-5-5        (cadena exacta, sin sufijo de fecha)
# AI_EFFORT=medium                  (low | medium | high)
# AI_PROVIDER=anthropic             (anthropic | mock | off; mock se ignora en producción)
# AI_FALLBACKS=on                   (off desactiva el respaldo del lado del servidor ante un rechazo del modelo)
# AI_RATE_PER_10MIN=5               (por token + IP)
# AI_RATE_PER_DAY=30                (por token + IP)
# AI_GLOBAL_PER_DAY=60              (tope global diario por instancia)
# AI_ALLOWED_ORIGINS=               (lista separada por comas; vacío = el origen del propio despliegue)
